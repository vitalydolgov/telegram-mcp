# Copy to .env for local runs. The server does not load this file.
# mcp_launch.sh reads the process environment (connector secrets).
# For a local smoke test: set -a && source .env && set +a

# From https://my.telegram.org — required
TG_API_ID=
TG_API_HASH=

# Cloud password, only while finishing QR login. Never pass it as a tool argument.
# TG_2FA_PASSWORD=

# INFO, DEBUG, WARNING
# TG_MCP_LOG_LEVEL=INFO
